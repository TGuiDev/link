NEXT_PUBLIC_APP_URL=http://localhost:3000

# Conexão MongoDB (MongoDB Atlas ou Local)
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB=link

# Chaves Secretas (Gere strings seguras e aleatórias)
AUTH_SECRET=use-a-long-random-secret-for-jwt-session
API_KEY_SECRET=use-a-long-random-secret-for-api-keys

# OAuth - Google (Opcional - Google Cloud Console)
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# OAuth - GitHub (Opcional - GitHub Developer Settings)
AUTH_GITHUB_ID=your-github-client-id
AUTH_GITHUB_SECRET=your-github-client-secret

# OAuth - Discord (Opcional - Discord Developer Portal)
AUTH_DISCORD_ID=your-discord-client-id
AUTH_DISCORD_SECRET=your-discord-client-secret

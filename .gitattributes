# Set default behavior, that is, text files will be normalized to LF on checkout.
* text=auto eol=lf

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout.
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.toml text eol=lf
*.env* text eol=lf

# Denote all binary files that should not be modified by git.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg text eol=lf
*.ttf binary
*.woff binary
*.woff2 binary
*.eot binary
*.pdf binary

# GitHub export ignore
.github export-ignore
.vscode export-ignore
.editorconfig export-ignore
.gitattributes export-ignore
.gitignore export-ignore
